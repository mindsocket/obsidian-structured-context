{
	"name": "obsidian-structured-context",
	"version": "0.1.2",
	"private": true,
	"description": "Inline validation hints for structured-context spaces in Obsidian.",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"test": "node scripts/unit-test.mjs",
		"test:smoke": "node scripts/smoke-test.mjs",
		"install-to-vault": "bash scripts/install-to-vault.sh",
		"preversion": "npm run lint && npm test && npm run build && npm run test:smoke",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"postversion": "git push --follow-tags",
		"lint": "biome check && eslint .",
		"lint:fix": "biome check --write && eslint --fix ."
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "9.30.1",
		"@eslint/json": "0.14.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"lefthook": "^2.1.4",
		"obsidian": "1.14.4",
		"structured-context": "^0.17.1",
		"structured-context-map-views": "^0.1.0",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.72.0"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
